# Neon Postgres（手元では Neon の開発用ブランチの接続文字列を使う）
DATABASE_URL=

# LINE Messaging API（LINE Developers のチャネル設定から取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LLM の API キー（使うプロバイダーの分だけ設定する）
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 管理画面（Auth.js + Google ログイン）
# AUTH_SECRET は `openssl rand -base64 32` で作る
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 最初の管理者のメールアドレス（初回ログイン時に admins に登録される）
INITIAL_ADMIN_EMAIL=
